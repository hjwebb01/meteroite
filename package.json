{
  "name": "meteroite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:convex": "node scripts/check-convex-modules.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:models": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-models.mts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.10",
    "@inngest/middleware-sentry": "^1.0.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@pierre/diffs": "^1.5.1",
    "@sentry/nextjs": "^11.4.0",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "inngest": "^4.21.1",
    "input-otp": "^1.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.5",
    "openai": "^7.27.0",
    "proper-lockfile": "^4.1.2",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/compat": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "convex-test": "^0.0.60",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "firecrawl": {
      "axios": "1.20.0"
    },
    "ansi-to-react": {
      "linkify-it": "5.0.2"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11.17.0"
  }
